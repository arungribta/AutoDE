# Allowlist: the package ships only what is named below. Everything else in the
# folder — sources, tests, local tool folders (.claude/, .venv/, .ai-context/),
# tsc's per-module dist/ output — stays out, including anything added later.
**
!package.json
!README.md
!CHANGELOG.md
!LICENSE
# The esbuild bundles and the licences of what they contain (phase 3): the
# extension, the autode CLI and MCP server (PA2), and the mcp-server.js shim.
!dist/extension.js
!dist/autode.js
!dist/mcp-server.js
!dist/THIRD-PARTY-NOTICES.md
# The Knowledge Explorer's graph library (C5b), loaded by its webview.
!dist/cytoscape.min.js
# Icons: marketplace PNG, the MCP server's PNG, the activity-bar glyph.
!media/autode-icon-256.png
!media/autode-icon-64.png
!media/autode-activitybar.svg
# Webviews and custom editors.
!media/sidebar.html
!media/workflow.html
!media/runbook.html
!media/port-skill.html
!media/explorer.html
!media/editors/*.html
# Bundled interview skills and Tier-2 primitives; JSON Schemas for yamlValidation.
!skills/*.json
!primitive-definitions/**
!platform-operations/**
!platforms/*.yaml
# Workflow templates (PA3a); agent role templates and skill folders (PA3b).
!workflows/*.yaml
!prerequisites.yaml
!agents/*.md
# Starter skills for Port a Skill (PA4): one knowledge skill, one procedure skill.
!examples/skills/**
!skills/*/**
!skills/external.yaml
!docs/schemas/*.json
