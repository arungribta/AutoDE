{
  "name": "auto-data-engineering-hub",
  "displayName": "AutoDE — Data Engineering Workspace",
  "description": "AI-powered data engineering workspace with agentic orchestration, multi-phase workflows, and rich artifact generation for Snowflake, Databricks, and BigQuery.",
  "version": "0.5.0",
  "publisher": "Arun Gribta",
  "license": "MIT",
  "icon": "media/logo.svg",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arungribta/AutoDE"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "data engineering",
    "snowflake",
    "databricks",
    "dbt",
    "etl",
    "pipeline",
    "ai",
    "agent",
    "workflow",
    "orchestration"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:autoDataEngineeringHubSidebar",
    "onView:autoDataEngineeringHubPanelView",
    "onCommand:autoDataEngineeringHub.openSidebar",
    "onCommand:autoDataEngineeringHub.generatePlan",
    "onCommand:autoDataEngineeringHub.executePlan",
    "onCommand:autoDataEngineeringHub.resetSession",
    "onCommand:autoDataEngineeringHub.newProject"
  ],
  "contributes": {
    "commands": [
      {
        "command": "autoDataEngineeringHub.openSidebar",
        "title": "AutoDE: Open Sidebar"
      },
      {
        "command": "autoDataEngineeringHub.generatePlan",
        "title": "AutoDE: Generate Plan"
      },
      {
        "command": "autoDataEngineeringHub.executePlan",
        "title": "AutoDE: Execute Plan"
      },
      {
        "command": "autoDataEngineeringHub.resetSession",
        "title": "AutoDE: Reset Session"
      },
      {
        "command": "autoDataEngineeringHub.newProject",
        "title": "AutoDE: New Project"
      },
      {
        "command": "autoDataEngineeringHub.testConnection",
        "title": "AutoDE: Test Connection"
      },
      {
        "command": "autoDataEngineeringHub.sourceAssessment",
        "title": "AutoDE: Run Source Assessment"
      },
      {
        "command": "autoDataEngineeringHub.syncMetadata",
        "title": "AutoDE: Sync Metadata"
      },
      {
        "command": "autoDataEngineeringHub.reindex",
        "title": "AutoDE: Re-index Context"
      },
      {
        "command": "autoDataEngineeringHub.testCopilot",
        "title": "AutoDE: Test Copilot"
      },
      {
        "command": "autoDataEngineeringHub.listCopilotInfo",
        "title": "AutoDE: List Copilot Info"
      },
      {
        "command": "autoDataEngineeringHub.debugListExtensions",
        "title": "AutoDE: Debug List Extensions"
      },
      {
        "command": "autoDataEngineeringHub.copilotHandoff",
        "title": "AutoDE: Copilot Handoff"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autoDataEngineeringHub",
          "title": "AutoDE",
          "icon": "media/logo.svg"
        }
      ],
      "panel": [
        {
          "id": "autoDataEngineeringHubPanel",
          "title": "AutoDE Dashboard",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "autoDataEngineeringHub": [
        {
          "id": "autoDataEngineeringHubSidebar",
          "name": "Workspace",
          "type": "webview"
        }
      ],
      "autoDataEngineeringHubPanel": [
        {
          "id": "autoDataEngineeringHubPanelView",
          "name": "Dashboard",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "autoDE.dataModelEditor",
        "displayName": "AutoDE Data Model",
        "selector": [
          { "filenamePattern": "*.sql" }
        ],
        "priority": "option"
      },
      {
        "viewType": "autoDE.sttmEditor",
        "displayName": "AutoDE STTM Mapping",
        "selector": [
          { "filenamePattern": "*.yaml" }
        ],
        "priority": "option"
      },
      {
        "viewType": "autoDE.graphEditor",
        "displayName": "AutoDE Knowledge Graph",
        "selector": [
          { "filenamePattern": "*.json" }
        ],
        "priority": "option"
      },
      {
        "viewType": "autoDE.profileEditor",
        "displayName": "AutoDE Data Profile",
        "selector": [
          { "filenamePattern": "*.md" }
        ],
        "priority": "option"
      },
      {
        "viewType": "autoDE.docEditor",
        "displayName": "AutoDE Architecture Doc",
        "selector": [
          { "filenamePattern": "*.md" }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "AutoDE",
      "properties": {
        "autoDataEngineeringHub.defaultProvider": {
          "type": "string",
          "enum": ["snowflake", "databricks", "bigquery", "redshift", "synapse", "other"],
          "default": "snowflake",
          "description": "Default data platform provider."
        },
        "autoDataEngineeringHub.defaultSnowflakeAccount": {
          "type": "string", "default": "",
          "description": "Default Snowflake account identifier."
        },
        "autoDataEngineeringHub.defaultSnowflakeUsername": {
          "type": "string", "default": "",
          "description": "Default Snowflake username."
        },
        "autoDataEngineeringHub.defaultSnowflakeWarehouse": {
          "type": "string", "default": "",
          "description": "Default Snowflake warehouse."
        },
        "autoDataEngineeringHub.defaultSnowflakeDatabase": {
          "type": "string", "default": "",
          "description": "Default Snowflake database."
        },
        "autoDataEngineeringHub.defaultSnowflakeSchema": {
          "type": "string", "default": "PUBLIC",
          "description": "Default Snowflake schema."
        },
        "autoDataEngineeringHub.defaultSnowflakeRole": {
          "type": "string", "default": "SYSADMIN",
          "description": "Default Snowflake role."
        },
        "autoDataEngineeringHub.defaultSnowflakeAuthMode": {
          "type": "string",
          "enum": ["key-pair", "username-password", "oauth", "external-browser", "mcp"],
          "default": "key-pair",
          "description": "Snowflake authentication mode."
        },
        "autoDataEngineeringHub.snowflakePrivateKeyPath": {
          "type": "string", "default": "",
          "description": "Path to Snowflake private key."
        },
        "autoDataEngineeringHub.metadataCachingDurationMinutes": {
          "type": "number", "default": 15,
          "description": "Metadata caching duration in minutes."
        },
        "autoDataEngineeringHub.queryTimeoutSeconds": {
          "type": "number", "default": 120,
          "description": "Default query timeout in seconds."
        },
        "autoDataEngineeringHub.readOnlyMode": {
          "type": "boolean", "default": true,
          "description": "Restrict to read-only mode."
        },
        "autoDataEngineeringHub.enableSessionReuse": {
          "type": "boolean", "default": true,
          "description": "Enable session reuse."
        },
        "autoDataEngineeringHub.autoDocumentationEnabled": {
          "type": "boolean", "default": true,
          "description": "Auto-generate documentation."
        },
        "autoDataEngineeringHub.telemetryEnabled": {
          "type": "boolean", "default": false,
          "description": "Allow telemetry (opt-in)."
        },
        "autoDataEngineeringHub.activeLlmProvider": {
          "type": "string",
          "enum": ["azure-openai", "openai", "anthropic", "gemini", "ollama", "copilot"],
          "default": "copilot",
          "description": "Active LLM provider."
        },
        "autoDataEngineeringHub.activeLlmModel": {
          "type": "string", "default": "gpt-4o-mini",
          "description": "LLM model name."
        },
        "autoDataEngineeringHub.llmEndpoint": {
          "type": "string", "default": "",
          "description": "Custom LLM endpoint."
        },
        "autoDataEngineeringHub.extensionDisplayName": {
          "type": "string", "default": "AutoDE — Data Engineering Workspace",
          "description": "Extension display name."
        },
        "autoDataEngineeringHub.extensionDescription": {
          "type": "string",
          "default": "AI-powered data engineering workspace with agentic orchestration, multi-phase workflows, and rich artifact generation.",
          "description": "Extension description."
        },
        "autoDataEngineeringHub.copilotProgrammaticConsent": {
          "type": "boolean", "default": false,
          "description": "Allow programmatic use of GitHub Copilot (opt-in)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "snowflake-sdk": "^2.0.0"
  }
}