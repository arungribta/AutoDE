# AutoDE working state (v0.36.0): .autode/local/ is per engineer and rebuildable.
# AutoDE also writes .autode/.gitignore itself; this line covers this repo's own use.
.autode/local/

# Enterprise Context Layer (pre-v0.36.0 .ai-context/) — ignore derived/transient only
# (context/, spec/, sources.yaml, target-environment.yaml are committed)
.ai-context/derived/
.ai-context/state.json
.ai-context/*.tmp.*

# Chat sessions (Phase F, v0.9.0) — local/exploratory transcripts, unlike the
# curated, committed BPS. Includes the abandoned-interview carryover notes
# registered as a context source (their extracted graph content persists
# separately via the normal context layer; the note file itself is not meant
# to be shared/committed).
.ai-context/chats/

# Eval harness: rolling outputs (baselines/ is committed)
test/reference/retail-orders/eval-report.md
test/reference/retail-orders/eval-results.json
