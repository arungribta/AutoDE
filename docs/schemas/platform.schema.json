{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autode.dev/schemas/platform.schema.json",
  "title": "AutoDE platform definition",
  "description": "What a platform is and what AutoDE can do with it: category, access, dialect, capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "title",
    "category",
    "transports",
    "capabilities"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "The connection platform id: snowflake, databricks, oracle, redshift …"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "category": {
      "enum": [
        "warehouse",
        "lakehouse",
        "semantic",
        "catalog",
        "orchestration",
        "bi"
      ]
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "sql",
          "cli",
          "http",
          "file"
        ]
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "string"
            },
            "minVersion": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+){0,3}$",
              "description": "A version such as 8.0 or 3.5.1."
            },
            "install": {
              "type": "string"
            },
            "credentialEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "The environment variable the CLI reads a password or token from: AutoDE passes the credential there, never as an argument."
            },
            "binary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "win32": {
                  "type": "string"
                },
                "default": {
                  "type": "string"
                }
              },
              "description": "The executable's name per OS, when it differs from command."
            },
            "wellKnownDirs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "win32": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "default": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "description": "Folders the vendor's installer uses, looked in when the CLI isn't on PATH."
            },
            "versionArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "propertyNames": {
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "description": "Environment variables set on every call (never a secret): for example turning the CLI's pager off."
            },
            "listProfiles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The arguments that list the CLI's own profiles, one per line."
            },
            "statement": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "description": "How a statement runs through the CLI, for a platform without an adapter class: {sql} and {id} are filled in, and the connection's arguments added.",
              "properties": {
                "mode": {
                  "enum": [
                    "sync",
                    "async"
                  ]
                },
                "run": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "args"
                  ],
                  "properties": {
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rows": {
                      "type": "string"
                    }
                  }
                },
                "submit": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "args",
                    "id"
                  ],
                  "properties": {
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "id": {
                      "type": "string"
                    }
                  }
                },
                "poll": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "args",
                    "status",
                    "finished",
                    "failed"
                  ],
                  "properties": {
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "status": {
                      "type": "string"
                    },
                    "finished": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "failed": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "error": {
                      "type": "string"
                    },
                    "hasResult": {
                      "type": "string"
                    }
                  }
                },
                "fetch": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "args",
                    "rows"
                  ],
                  "properties": {
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rows": {
                      "type": "string"
                    },
                    "columns": {
                      "type": "string"
                    },
                    "columnName": {
                      "type": "string"
                    },
                    "nextToken": {
                      "type": "string"
                    },
                    "nextTokenArg": {
                      "type": "string"
                    },
                    "cells": {
                      "enum": [
                        "plain",
                        "typed"
                      ]
                    }
                  }
                },
                "cancel": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "args"
                  ],
                  "properties": {
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            }
          }
        }
      }
    },
    "versionOperation": {
      "type": "string"
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "description": "What a connection to the platform is made of, for a platform whose card is drawn from this file.",
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "label"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "personal": {
                "type": "boolean"
              },
              "secret": {
                "type": "boolean"
              },
              "cliArg": {
                "type": "string",
                "pattern": "^--?[a-z][a-z0-9-]*$"
              },
              "cliScope": {
                "enum": [
                  "every",
                  "submit"
                ]
              },
              "env": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            }
          }
        },
        "idFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exactlyOne": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "authModes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "label"
            ],
            "properties": {
              "mode": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "cliProfileField": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "source",
              "target"
            ]
          }
        },
        "targetNote": {
          "type": "string"
        }
      }
    },
    "dialect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifierQuote": {
          "enum": [
            "\"",
            "`"
          ]
        },
        "unquotedCase": {
          "enum": [
            "upper",
            "lower",
            "preserve"
          ]
        },
        "booleans": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "fragments": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "scopeLevel": {
      "enum": [
        "database",
        "schema"
      ],
      "description": "What a read's databases parameter names here: databases or catalogs (default), or schemas (Oracle's owners)."
    },
    "capabilities": {
      "type": "object",
      "description": "For each AutoDE capability: supported, partly or not applicable; its operations; the privileges it needs.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "support"
        ],
        "properties": {
          "support": {
            "enum": [
              "supported",
              "partly",
              "not_applicable"
            ]
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "privileges": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "objectKinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
