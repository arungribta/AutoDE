{
  "name": "auto-data-engineering-hub",
  "displayName": "Auto Data Engineering Hub",
  "description": "Plan and execute AI-powered data engineering workflows with Snowflake and modern data platform orchestration.",
  "version": "0.1.0",
  "publisher": "ArunGribta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/data-agent-hub"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Data Science"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:autoDataEngineeringHubSidebar",
    "onCommand:autoDataEngineeringHub.openSidebar",
    "onCommand:autoDataEngineeringHub.generatePlan",
    "onCommand:autoDataEngineeringHub.executePlan",
    "onCommand:autoDataEngineeringHub.resetSession"
  ],
  "contributes": {
    "commands": [
      {
        "command": "autoDataEngineeringHub.openSidebar",
        "title": "Auto Data Engineering Hub: Open Sidebar"
      },
      {
        "command": "autoDataEngineeringHub.generatePlan",
        "title": "Auto Data Engineering Hub: Generate Plan"
      },
      {
        "command": "autoDataEngineeringHub.executePlan",
        "title": "Auto Data Engineering Hub: Execute Plan"
      },
      {
        "command": "autoDataEngineeringHub.resetSession",
        "title": "Auto Data Engineering Hub: Reset Session"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autoDataEngineeringHub",
          "title": "Auto Data Engineering Hub",
          "icon": "media/logo.svg",
          "views": [
            {
              "id": "autoDataEngineeringHubSidebar",
              "name": "Hub"
            }
          ]
        }
      ]
    },
    "views": {
      "autoDataEngineeringHub": [
        {
          "id": "autoDataEngineeringHubSidebar",
          "name": "Auto Data Engineering Hub",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Auto Data Engineering Hub",
      "properties": {
        "autoDataEngineeringHub.defaultProvider": {
          "type": "string",
          "enum": [
            "snowflake",
            "databricks",
            "bigquery",
            "redshift",
            "synapse",
            "other"
          ],
          "default": "snowflake",
          "description": "Default data platform provider."
        },
        "autoDataEngineeringHub.defaultSnowflakeAccount": {
          "type": "string",
          "default": "",
          "description": "Default Snowflake account identifier."
        },
        "autoDataEngineeringHub.defaultSnowflakeUsername": {
          "type": "string",
          "default": "",
          "description": "Default Snowflake username used for login."
        },
        "autoDataEngineeringHub.defaultSnowflakeWarehouse": {
          "type": "string",
          "default": "",
          "description": "Default Snowflake warehouse."
        },
        "autoDataEngineeringHub.defaultSnowflakeDatabase": {
          "type": "string",
          "default": "",
          "description": "Default Snowflake database."
        },
        "autoDataEngineeringHub.defaultSnowflakeSchema": {
          "type": "string",
          "default": "PUBLIC",
          "description": "Default Snowflake schema."
        },
        "autoDataEngineeringHub.defaultSnowflakeRole": {
          "type": "string",
          "default": "SYSADMIN",
          "description": "Default Snowflake role."
        },
        "autoDataEngineeringHub.defaultSnowflakeAuthMode": {
          "type": "string",
          "enum": [
            "key-pair",
            "username-password",
            "oauth",
            "external-browser",
            "mcp"
          ],
          "default": "key-pair",
          "description": "Snowflake authentication mode for the active provider."
        },
        "autoDataEngineeringHub.snowflakePrivateKeyPath": {
          "type": "string",
          "default": "",
          "description": "Path to the private key used for Snowflake key-pair authentication."
        },
        "autoDataEngineeringHub.metadataCachingDurationMinutes": {
          "type": "number",
          "default": 15,
          "description": "Metadata caching duration in minutes."
        },
        "autoDataEngineeringHub.queryTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "description": "Default query timeout in seconds."
        },
        "autoDataEngineeringHub.readOnlyMode": {
          "type": "boolean",
          "default": true,
          "description": "Restrict provider operations to read-only mode when enabled."
        },
        "autoDataEngineeringHub.enableSessionReuse": {
          "type": "boolean",
          "default": true,
          "description": "Enable provider session reuse for performance."
        },
        "autoDataEngineeringHub.autoDocumentationEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically generate documentation when possible."
        },
        "autoDataEngineeringHub.telemetryEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Allow telemetry for the extension."
        },
        "autoDataEngineeringHub.activeLlmProvider": {
          "type": "string",
          "enum": [
            "azure-openai",
            "openai",
            "anthropic",
            "gemini",
            "ollama",
            "copilot"
          ],
          "default": "copilot",
          "description": "Active LLM provider used for planning."
        },
        "autoDataEngineeringHub.activeLlmModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "LLM model name used by the selected provider."
        },
        "autoDataEngineeringHub.llmEndpoint": {
          "type": "string",
          "default": "",
          "description": "Custom endpoint for the selected LLM provider."
        },
        "autoDataEngineeringHub.extensionDisplayName": {
          "type": "string",
          "default": "Auto Data Engineering Hub",
          "description": "Custom display name shown in the extension UI."
        },
        "autoDataEngineeringHub.extensionDescription": {
          "type": "string",
          "default": "Plan and execute AI-powered data engineering workflows with Snowflake and modern data platform orchestration.",
          "description": "Custom extension description shown in metadata and UI."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "data-agent-hub": "file:",
    "snowflake-sdk": "^2.0.0"
  }
}
