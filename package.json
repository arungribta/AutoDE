{
  "name": "auto-data-engineering-hub",
  "displayName": "AutoDE — Data Engineering Workspace",
  "description": "AI-powered data engineering workspace with agentic orchestration, multi-phase workflows, and rich artifact generation for Snowflake, Databricks, and BigQuery.",
  "version": "0.35.0",
  "publisher": "Arun Gribta",
  "license": "MIT",
  "icon": "media/logo.svg",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arungribta/AutoDE"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "data engineering",
    "snowflake",
    "databricks",
    "dbt",
    "etl",
    "pipeline",
    "ai",
    "agent",
    "workflow",
    "orchestration"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:autoDataEngineeringHubSidebar",
    "onView:autoDataEngineeringHubPanelView",
    "onCommand:autoDataEngineeringHub.openSidebar",
    "onCommand:autoDataEngineeringHub.generatePlan",
    "onCommand:autoDataEngineeringHub.executePlan",
    "onCommand:autoDataEngineeringHub.resetSession"
  ],
  "contributes": {
    "commands": [
      {
        "command": "autoDataEngineeringHub.openSidebar",
        "title": "AutoDE: Open Sidebar"
      },
      {
        "command": "autoDataEngineeringHub.generatePlan",
        "title": "AutoDE: Generate Plan"
      },
      {
        "command": "autoDataEngineeringHub.executePlan",
        "title": "AutoDE: Execute Plan"
      },
      {
        "command": "autoDataEngineeringHub.generatePipelineSpec",
        "title": "AutoDE: Generate Pipeline Spec"
      },
      {
        "command": "autoDataEngineeringHub.resetSession",
        "title": "AutoDE: Reset Session"
      },
      {
        "command": "autoDataEngineeringHub.testConnection",
        "title": "AutoDE: Test Source Connection"
      },
      {
        "command": "autoDataEngineeringHub.testTargetConnection",
        "title": "AutoDE: Test Target Connection"
      },
      {
        "command": "autoDataEngineeringHub.sourceAssessment",
        "title": "AutoDE: Run Source Assessment"
      },
      {
        "command": "autoDataEngineeringHub.disconnectDataPlatform",
        "title": "AutoDE: Disconnect Source Data Platform"
      },
      {
        "command": "autoDataEngineeringHub.disconnectTargetDataPlatform",
        "title": "AutoDE: Disconnect Target Data Platform"
      },
      {
        "command": "autoDataEngineeringHub.browseSourceDatabase",
        "title": "AutoDE: Browse Source Database/Schema"
      },
      {
        "command": "autoDataEngineeringHub.browseTargetDatabase",
        "title": "AutoDE: Browse Target Database/Schema"
      },
      {
        "command": "autoDataEngineeringHub.ingestFileAsSourceContext",
        "title": "AutoDE: Ingest File as Source Context (CSV/JSON/DDL)"
      },
      {
        "command": "autoDataEngineeringHub.createMapping",
        "title": "AutoDE: Create Mapping (Source → Target)"
      },
      {
        "command": "autoDataEngineeringHub.buildSemanticLayer",
        "title": "AutoDE: Build Unified Semantic Layer Snapshot"
      },
      {
        "command": "autoDataEngineeringHub.compactContextLedger",
        "title": "AutoDE: Compact Context Ledger"
      },
      {
        "command": "autoDataEngineeringHub.addPackDocument",
        "title": "AutoDE: Add Document to Business-Problem Pack"
      },
      {
        "command": "autoDataEngineeringHub.applyPack",
        "title": "AutoDE: Apply Business-Problem Pack"
      },
      {
        "command": "autoDataEngineeringHub.runConformance",
        "title": "AutoDE: Run Conformance Check"
      },
      {
        "command": "autoDataEngineeringHub.verifyClaims",
        "title": "AutoDE: Verify Claims with Probes"
      },
      {
        "command": "autoDataEngineeringHub.proposeVocabulary",
        "title": "AutoDE: Propose Vocabulary"
      },
      {
        "command": "autoDataEngineeringHub.openEstate",
        "title": "AutoDE: Open Estate (Systems & Environments)"
      },
      {
        "command": "autoDataEngineeringHub.whatTheAgentSaw",
        "title": "AutoDE: What the Agent Saw"
      },
      {
        "command": "autoDataEngineeringHub.explainArtifact",
        "title": "AutoDE: Explain This Artifact"
      },
      {
        "command": "autoDataEngineeringHub.reVerifySourceSchema",
        "title": "AutoDE: Re-verify Source Schema"
      },
      {
        "command": "autoDataEngineeringHub.syncMetadata",
        "title": "AutoDE: Sync Metadata"
      },
      {
        "command": "autoDataEngineeringHub.reindex",
        "title": "AutoDE: Re-index Context"
      },
      {
        "command": "autoDataEngineeringHub.testLanguageModel",
        "title": "AutoDE: Test Language Model (Copilot / Claude)"
      },
      {
        "command": "autoDataEngineeringHub.listLanguageModelInfo",
        "title": "AutoDE: Show Active Language Model Status"
      },
      {
        "command": "autoDataEngineeringHub.listLanguageModels",
        "title": "AutoDE: List Language Models"
      },
      {
        "command": "autoDataEngineeringHub.testCopilot",
        "title": "AutoDE: Test Copilot"
      },
      {
        "command": "autoDataEngineeringHub.listCopilotInfo",
        "title": "AutoDE: List Copilot Info"
      },
      {
        "command": "autoDataEngineeringHub.debugListExtensions",
        "title": "AutoDE: Debug List Extensions"
      },
      {
        "command": "autoDataEngineeringHub.copilotHandoff",
        "title": "AutoDE: Copilot Handoff"
      },
      {
        "command": "autoDataEngineeringHub.importToolSkill",
        "title": "AutoDE: Import Tool Skill"
      },
      {
        "command": "autoDataEngineeringHub.runToolSkill",
        "title": "AutoDE: Run Tool Skill"
      },
      {
        "command": "autoDataEngineeringHub.reviewToolSkill",
        "title": "AutoDE: Review Tool Skill"
      },
      {
        "command": "autoDataEngineeringHub.publishToolSkill",
        "title": "AutoDE: Publish Tool Skill"
      },
      {
        "command": "autoDataEngineeringHub.deprecateToolSkill",
        "title": "AutoDE: Deprecate Tool Skill"
      },
      {
        "command": "autoDataEngineeringHub.retireToolSkill",
        "title": "AutoDE: Retire Tool Skill"
      },
      {
        "command": "autoDataEngineeringHub.newChat",
        "title": "AutoDE: New Chat"
      },
      {
        "command": "autoDataEngineeringHub.chatHistory",
        "title": "AutoDE: Chat History"
      },
      {
        "command": "autoDataEngineeringHub.discardChat",
        "title": "AutoDE: Discard Chat"
      },
      {
        "command": "autoDataEngineeringHub.connectToDataPlatform",
        "title": "AutoDE: Connect to Data Platform"
      },
      {
        "command": "autoDataEngineeringHub.testServiceAccountCredential",
        "title": "AutoDE: Test Service Account Credential"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "autoDataEngineeringHub.publishToolSkill",
          "when": "config.autoDataEngineeringHub.toolSkillManagementEnabled"
        },
        {
          "command": "autoDataEngineeringHub.deprecateToolSkill",
          "when": "config.autoDataEngineeringHub.toolSkillManagementEnabled"
        },
        {
          "command": "autoDataEngineeringHub.retireToolSkill",
          "when": "config.autoDataEngineeringHub.toolSkillManagementEnabled"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autoDataEngineeringHub",
          "title": "AutoDE",
          "icon": "media/logo.svg"
        }
      ],
      "panel": [
        {
          "id": "autoDataEngineeringHubPanel",
          "title": "AutoDE Dashboard",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "autoDataEngineeringHub": [
        {
          "id": "autoDataEngineeringHubSidebar",
          "name": "Workspace",
          "type": "webview"
        }
      ],
      "autoDataEngineeringHubPanel": [
        {
          "id": "autoDataEngineeringHubPanelView",
          "name": "Dashboard",
          "type": "webview"
        }
      ]
    },
    "yamlValidation": [
      {
        "fileMatch": "**/.ai-context/primitives/*.yaml",
        "url": "./docs/schemas/primitive-definition.schema.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "autoDE.dataModelEditor",
        "displayName": "AutoDE Data Model",
        "selector": [
          {
            "filenamePattern": "*.sql"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "autoDE.sttmEditor",
        "displayName": "AutoDE STTM Mapping",
        "selector": [
          {
            "filenamePattern": "*.yaml"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "autoDE.graphEditor",
        "displayName": "AutoDE Knowledge Graph",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "autoDE.profileEditor",
        "displayName": "AutoDE Data Profile",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "autoDE.docEditor",
        "displayName": "AutoDE Architecture Doc",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "AutoDE",
      "properties": {
        "autoDataEngineeringHub.defaultProvider": {
          "type": "string",
          "enum": [
            "snowflake",
            "databricks",
            "bigquery",
            "redshift",
            "synapse",
            "other"
          ],
          "default": "snowflake",
          "description": "Default data platform provider."
        },
        "autoDataEngineeringHub.defaultDatabricksWorkspaceUrl": {
          "type": "string",
          "default": "",
          "description": "Default Databricks workspace host (e.g. adb-1234567890123456.7.azuredatabricks.net). Scheme (https://) is optional."
        },
        "autoDataEngineeringHub.defaultDatabricksHttpPath": {
          "type": "string",
          "default": "",
          "description": "The target SQL warehouse's HTTP Path (e.g. /sql/1.0/warehouses/0123456789abcdef), copied from its Connection Details page."
        },
        "autoDataEngineeringHub.defaultDatabricksCatalog": {
          "type": "string",
          "default": "main",
          "description": "Default Databricks (Unity Catalog) catalog."
        },
        "autoDataEngineeringHub.defaultDatabricksCatalogType": {
          "type": "string",
          "enum": ["auto", "unity", "hive_metastore"],
          "default": "auto",
          "description": "Which metadata-introspection shape to use for the configured catalog. 'auto' infers it from the catalog name (the reserved 'hive_metastore' name vs. everything else); set explicitly when a workspace has more than one catalog type, or as a manual override for another catalog that shares the legacy metastore's limitations (no bulk information_schema)."
        },
        "autoDataEngineeringHub.defaultDatabricksSchema": {
          "type": "string",
          "default": "default",
          "description": "Default Databricks schema."
        },
        "autoDataEngineeringHub.defaultSnowflakeAccount": {
          "type": "string",
          "default": "",
          "description": "Default Snowflake account identifier."
        },
        "autoDataEngineeringHub.defaultSnowflakeUsername": {
          "type": "string",
          "default": "",
          "description": "Default Snowflake username."
        },
        "autoDataEngineeringHub.defaultSnowflakeWarehouse": {
          "type": "string",
          "default": "",
          "description": "Default Snowflake warehouse."
        },
        "autoDataEngineeringHub.defaultSnowflakeDatabase": {
          "type": "string",
          "default": "",
          "description": "Default Snowflake database."
        },
        "autoDataEngineeringHub.defaultSnowflakeSchema": {
          "type": "string",
          "default": "PUBLIC",
          "description": "Default Snowflake schema."
        },
        "autoDataEngineeringHub.defaultSnowflakeRole": {
          "type": "string",
          "default": "SYSADMIN",
          "description": "Default Snowflake role."
        },
        "autoDataEngineeringHub.defaultSnowflakeAuthMode": {
          "type": "string",
          "enum": [
            "key-pair",
            "username-password",
            "oauth",
            "external-browser",
            "mcp"
          ],
          "default": "key-pair",
          "description": "Snowflake authentication mode."
        },
        "autoDataEngineeringHub.snowflakePrivateKeyPath": {
          "type": "string",
          "default": "",
          "description": "Path to Snowflake private key."
        },
        "autoDataEngineeringHub.defaultTargetProvider": {
          "type": "string",
          "enum": [
            "snowflake",
            "databricks",
            "bigquery",
            "redshift",
            "synapse",
            "other"
          ],
          "default": "snowflake",
          "description": "Target data platform provider — independent of, and can be connected simultaneously with, the source platform above."
        },
        "autoDataEngineeringHub.defaultTargetDatabricksWorkspaceUrl": {
          "type": "string",
          "default": "",
          "description": "Target Databricks workspace host (e.g. adb-1234567890123456.7.azuredatabricks.net). Scheme (https://) is optional."
        },
        "autoDataEngineeringHub.defaultTargetDatabricksHttpPath": {
          "type": "string",
          "default": "",
          "description": "The target platform's SQL warehouse HTTP Path (e.g. /sql/1.0/warehouses/0123456789abcdef), copied from its Connection Details page."
        },
        "autoDataEngineeringHub.defaultTargetDatabricksCatalog": {
          "type": "string",
          "default": "main",
          "description": "Target Databricks (Unity Catalog) catalog."
        },
        "autoDataEngineeringHub.defaultTargetDatabricksCatalogType": {
          "type": "string",
          "enum": ["auto", "unity", "hive_metastore"],
          "default": "auto",
          "description": "Which metadata-introspection shape to use for the target's configured catalog. See defaultDatabricksCatalogType's description — same semantics, independent value for the target connection."
        },
        "autoDataEngineeringHub.defaultTargetDatabricksSchema": {
          "type": "string",
          "default": "default",
          "description": "Target Databricks schema."
        },
        "autoDataEngineeringHub.defaultTargetSnowflakeAccount": {
          "type": "string",
          "default": "",
          "description": "Target Snowflake account identifier — independent of, and can be connected simultaneously with, the source Snowflake account above."
        },
        "autoDataEngineeringHub.defaultTargetSnowflakeUsername": {
          "type": "string",
          "default": "",
          "description": "Target Snowflake username."
        },
        "autoDataEngineeringHub.defaultTargetSnowflakeWarehouse": {
          "type": "string",
          "default": "",
          "description": "Target Snowflake warehouse."
        },
        "autoDataEngineeringHub.defaultTargetSnowflakeDatabase": {
          "type": "string",
          "default": "",
          "description": "Target Snowflake database."
        },
        "autoDataEngineeringHub.defaultTargetSnowflakeSchema": {
          "type": "string",
          "default": "PUBLIC",
          "description": "Target Snowflake schema."
        },
        "autoDataEngineeringHub.defaultTargetSnowflakeRole": {
          "type": "string",
          "default": "SYSADMIN",
          "description": "Target Snowflake role."
        },
        "autoDataEngineeringHub.defaultTargetSnowflakeAuthMode": {
          "type": "string",
          "enum": [
            "key-pair",
            "username-password",
            "oauth",
            "external-browser",
            "mcp"
          ],
          "default": "key-pair",
          "description": "Target Snowflake authentication mode."
        },
        "autoDataEngineeringHub.targetSnowflakePrivateKeyPath": {
          "type": "string",
          "default": "",
          "description": "Path to the target connection's Snowflake private key."
        },
        "autoDataEngineeringHub.targetSnowflakeCliPath": {
          "type": "string",
          "default": "",
          "description": "Explicit path to the Snowflake CLI for the target connection (only if not found automatically). Leave blank if `snow` is on PATH."
        },
        "autoDataEngineeringHub.targetDatabricksCliPath": {
          "type": "string",
          "default": "",
          "description": "Explicit path to the Databricks CLI for the target connection (only if not found automatically)."
        },
        "autoDataEngineeringHub.metadataCachingDurationMinutes": {
          "type": "number",
          "default": 15,
          "description": "Metadata caching duration in minutes."
        },
        "autoDataEngineeringHub.queryTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "description": "Default query timeout in seconds."
        },
        "autoDataEngineeringHub.readOnlyMode": {
          "type": "boolean",
          "default": true,
          "description": "Restrict to read-only mode."
        },
        "autoDataEngineeringHub.enableSessionReuse": {
          "type": "boolean",
          "default": true,
          "description": "Enable session reuse."
        },
        "autoDataEngineeringHub.autoDocumentationEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Auto-generate documentation."
        },
        "autoDataEngineeringHub.telemetryEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Allow telemetry (opt-in)."
        },
        "autoDataEngineeringHub.activeLlmProvider": {
          "type": "string",
          "enum": [
            "azure-openai",
            "openai",
            "anthropic",
            "gemini",
            "ollama",
            "copilot",
            "claude"
          ],
          "enumDescriptions": [
            "Azure OpenAI (API key)",
            "OpenAI (API key)",
            "Anthropic Claude via api.anthropic.com (API key)",
            "Google Gemini (API key)",
            "Ollama (local server)",
            "GitHub Copilot via the VS Code Language Model API (no API key)",
            "Claude Code CLI, headless (no API key; uses your existing Claude Code login). Auto-detected, or set claudeCodePath."
          ],
          "default": "copilot",
          "description": "Active LLM provider."
        },
        "autoDataEngineeringHub.activeLlmModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "LLM model name. For the 'claude' provider this is passed to 'claude --model' when it looks like a Claude model (e.g. 'sonnet', 'opus', 'claude-sonnet-4'); otherwise Claude Code's default model is used."
        },
        "autoDataEngineeringHub.claudeCodePath": {
          "type": "string",
          "default": "",
          "description": "Path to the Claude Code CLI ('claude' / 'claude.exe'). Leave empty to auto-detect: PATH, then the binary bundled with the 'Claude Code for VS Code' extension. Only used when activeLlmProvider is 'claude'."
        },
        "autoDataEngineeringHub.llmEndpoint": {
          "type": "string",
          "default": "",
          "description": "Custom LLM endpoint."
        },
        "autoDataEngineeringHub.context.workingSetMaxTables": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Tables AutoDE keeps in its working set (the context graph and ledger). Imports and extractions beyond this go into the estate catalog only, and a table enters the working set when a task, spec or mapping uses it."
        },
        "autoDataEngineeringHub.context.evictAfterDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "While the working set is over its size, tables no task has used for this many days (and no confirmed fact is about) go back to the catalog."
        },
        "autoDataEngineeringHub.context.schemaTtlDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "description": "Schema facts older than this are re-checked against a connected source when a task uses them and before a plan runs."
        },
        "autoDataEngineeringHub.discovery.profileQueryBudget": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "description": "Most profiling queries one Source Assessment may run (one sampled query per table). Tables beyond the budget are reported as not profiled."
        },
        "autoDataEngineeringHub.discovery.profileConcurrency": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Profiling queries run in parallel during Source Assessment."
        },
        "autoDataEngineeringHub.artifactDirectory": {
          "type": "string",
          "default": "artifacts",
          "description": "Folder (relative to the active business problem's own folder, .ai-context/problems/<id>/) where AutoDE writes generated artifacts — alongside that problem's specification, context, and plan, so its knowledge base stays in one place."
        },
        "autoDataEngineeringHub.extensionDisplayName": {
          "type": "string",
          "default": "AutoDE — Data Engineering Workspace",
          "description": "Extension display name."
        },
        "autoDataEngineeringHub.extensionDescription": {
          "type": "string",
          "default": "AI-powered data engineering workspace with agentic orchestration, multi-phase workflows, and rich artifact generation.",
          "description": "Extension description."
        },
        "autoDataEngineeringHub.languageModelProgrammaticConsent": {
          "type": "boolean",
          "default": false,
          "description": "Allow AutoDE to programmatically use a locally-installed language model for its LLM calls (opt-in): GitHub Copilot via the VS Code Language Model API, or the Claude Code CLI."
        },
        "autoDataEngineeringHub.copilotProgrammaticConsent": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "_Deprecated — use `#autoDataEngineeringHub.languageModelProgrammaticConsent#`._ Still honored as a fallback for existing setups."
        },
        "autoDataEngineeringHub.primitiveManagementEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Allow publishing/deprecating declarative (Tier 2) transform primitives from the Primitives palette (opt-in). Off by default — a workspace's platform admin turns this on deliberately."
        },
        "autoDataEngineeringHub.toolSkillManagementEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Manage imported tool skills' lifecycle: imports start as drafts, and Publish/Deprecate/Retire Tool Skill keep numbered versions that plan steps can pin (opt-in). Reviewing and trusting a skill works either way."
        },
        "autoDataEngineeringHub.dataPlatformCliConsent": {
          "type": "boolean",
          "default": false,
          "description": "Allow AutoDE to shell out to a data-platform CLI (currently: 'snow connection list') to enumerate configured connections for 'AutoDE: Connect to Data Platform' (opt-in). CLI detection (a version check) does not require this."
        },
        "autoDataEngineeringHub.snowflakeCliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Snowflake CLI ('snow' / 'snow.exe'). Leave empty to auto-detect via PATH."
        },
        "autoDataEngineeringHub.databricksCliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Databricks CLI ('databricks' / 'databricks.exe'). Leave empty to auto-detect via PATH. Not required for connection enumeration, which reads '.databrickscfg' directly."
        },
        "autoDataEngineeringHub.serviceAccountCredentialRef": {
          "type": "string",
          "default": "",
          "markdownDescription": "A service-account credential pointer, set once by a platform team — deliberately a plain settings value, no interactive UI. JSON string: `{\"platform\":\"snowflake\",\"resolverId\":\"env\",\"ref\":\"prod\"}`. `resolverId` names a registered `CredentialResolver` ('env', 'cli', 'vscode-secret-storage', or a custom one). Verify with 'AutoDE: Test Service Account Credential'."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/bundle.cjs",
    "watch": "tsc -watch -p ./",
    "bundle": "node scripts/bundle.cjs",
    "vscode:prepublish": "tsc -p ./ && node scripts/bundle.cjs --production",
    "package": "vsce package",
    "mcp": "node dist/mcp-server.js",
    "test": "npm run compile && node test/functional.test.cjs",
    "eval": "npm run compile && node test/eval/run-eval.cjs",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
