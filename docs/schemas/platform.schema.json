{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autode.dev/schemas/platform.schema.json",
  "title": "AutoDE platform definition",
  "description": "What a platform is and what AutoDE can do with it: category, access, dialect, capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "title",
    "category",
    "transports",
    "capabilities"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "The connection platform id: snowflake, databricks, oracle, redshift …"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "category": {
      "enum": [
        "warehouse",
        "lakehouse",
        "semantic",
        "catalog",
        "orchestration",
        "bi"
      ]
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "sql",
          "cli",
          "http",
          "file"
        ]
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "string"
            },
            "minVersion": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+){0,3}$",
              "description": "A version such as 8.0 or 3.5.1."
            },
            "install": {
              "type": "string"
            },
            "credentialEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "The environment variable the CLI reads a password or token from: AutoDE passes the credential there, never as an argument."
            }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            }
          }
        }
      }
    },
    "versionOperation": {
      "type": "string"
    },
    "dialect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifierQuote": {
          "enum": [
            "\"",
            "`"
          ]
        },
        "unquotedCase": {
          "enum": [
            "upper",
            "lower",
            "preserve"
          ]
        },
        "booleans": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "fragments": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "scopeLevel": {
      "enum": [
        "database",
        "schema"
      ],
      "description": "What a read's databases parameter names here: databases or catalogs (default), or schemas (Oracle's owners)."
    },
    "capabilities": {
      "type": "object",
      "description": "For each AutoDE capability: supported, partly or not applicable; its operations; the privileges it needs.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "support"
        ],
        "properties": {
          "support": {
            "enum": [
              "supported",
              "partly",
              "not_applicable"
            ]
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "privileges": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "objectKinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
